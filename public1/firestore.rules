rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 認証済みユーザー本人のデータ (/users/{userId}) のみ読み書きを許可
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 将来サブコレクションが追加された場合も本人のみ許可
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 上記以外のドキュメントへのアクセスはすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
